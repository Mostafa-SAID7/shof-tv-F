modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[build]
files = ["package.json", "package-lock.json", "angular.json", "tsconfig.json", "src"]

[workflows]
runButton = "Start Development Server"

[[workflows.workflow]]
name = "Start Development Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --legacy-peer-deps && npm start -- --host 0.0.0.0 --port 4200 --poll"
waitForPort = 4200

[[ports]]
localPort = 4200
externalPort = 80

