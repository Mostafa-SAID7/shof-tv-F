{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/shoftv-landing",
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.4 --activate && pnpm install --frozen-lockfile",
  "framework": null,
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "^/(?!.*\\.).*$",
      "dest": "/index.html"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": ".*\\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|otf|ico)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
