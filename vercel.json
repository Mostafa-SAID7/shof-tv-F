{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/shoftv-landing/browser",
  "public": true,
  "github": {
    "silent": true
  },
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "^/(?!.*\\\\.).*$",
      "destination": "/index.html"
    },
    {
      "src": "/js/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/css/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": ".*\\.(js|css|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|otf)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
